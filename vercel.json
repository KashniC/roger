{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/watches",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/cron/sheet",
      "schedule": "20 * * * *"
    }
  ]
}
